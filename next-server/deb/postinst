#!/bin/sh
# The unit lives in /etc/systemd/system and is replaced on every upgrade.
set -e

if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload
	# A running server switches to the new binary: on an upgrade, and when
	# next-server-compat replaces next-server, which is a fresh install of
	# it. try-restart leaves a stopped server alone, so a new node still
	# waits for the administrator.
	if [ -f /etc/next-server/config.json ]; then
		systemctl try-restart next-server.service
	fi
fi

exit 0
